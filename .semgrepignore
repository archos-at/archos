# Paths Semgrep should not scan. Gitignore-style syntax; this is in addition to
# .gitignore, which Semgrep already respects. Mirrors the exclusions the old
# Sonar config carried. Tune here as false positives show up during Phase 1.

# Dependencies / virtualenvs
node_modules/
.venv/
venv/
__pycache__/

# Build output / caches
.next/
dist/
build/
*.min.js
*.min.css

# Generated / vendored code
**/generated.ts
**/*.generated.*
**/migrations/**
**/migrations/**
**/__mocks__/**
**/mocks/**
contracts/cards/schemas.json

# Non-source assets and data
data/
*.j2
docs/

# Tests and stories: keep SAST focused on shipped code. Remove a line here if you
# want Semgrep to also flag issues in test/fixture code.
**/*.stories.tsx
**/*.spec.ts
**/*.spec.tsx
**/test_*.py
**/conftest.py
# The test-support packages (`<package>_testing`, ADR-0145 row 5); never in an image.
**/testing/*_testing/**
# The table of secret-shaped and harmless notes that the memory content guard
# is held to in both languages (bff/knowledge/note-content-guard.ts and
# agent/knowledge/memory_content_guard.py). Its JSON web token, keys and account
# numbers are invented cases the guard must refuse, not credentials.
tests/fixtures/memory_note_guard_cases.json
