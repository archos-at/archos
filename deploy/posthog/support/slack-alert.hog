// Posts Piloti product feedback to Slack.
// Fed by the BFF's server events (apps/workspace/bff/product-feedback/service.ts):
//   product_feedback_ticket_opened  -> a new alert, per kind, with a claim button
//   product_feedback_reply_sent     -> a reply in the alert's thread
// Both carry app_host, the deployment the report lives in: staging and production
// share this project, so the claim button must point at the right one. The
// ticket id in the alert's links is also how claim-update.hog finds it.
let props := event.properties
let ticketId := props.ticket_id
if (empty(ticketId)) {
  print('No ticket_id on the event; nothing to post')
  return
}
let host := props.app_host
if (empty(host)) {
  host := inputs.default_host
}
let isProd := host == inputs.default_host

let res := postHogGetTicket({'ticket_id': ticketId})
if (res.status != 200) {
  throw Error(f'Failed to fetch ticket ({res.status}): {res.body}')
}
let ticket := res.body
let number := ticket.ticket_number ?? ticket.number
let kind := props.kind
// Every word a person reads comes from the `copy` input, keyed in English, the
// way the app reads its i18n dictionaries: no German in the code.
let copy := inputs.copy
let titles := {
  'bug': f'🐞 {copy.title_bug}',
  'idea': f'💡 {copy.title_idea}',
  'praise': f'❤️ {copy.title_praise}',
  'question': f'❓ {copy.title_question}'
}
let title := titles[kind] ?? f'📝 {copy.title_other}'
let ticketUrl := f'https://eu.posthog.com/project/{project.id}/support/tickets/{ticketId}'
let claimUrl := f'https://{host}/app/platform/feedback?claim={ticketId}'
let where := isProd ? '' : f' · 🧪 {host}'

// The member's words stay in PostHog. Slack is a US processor that the
// data-flow register (configs/subprocessors/slack.yaml) lists for ids, the kind
// and links only, so no alert quotes a report or a reply: the team opens the
// ticket to read it.

// The alerts that mention `needle`, newest first: every top-level message in the
// channel whose blocks carry it. With the ticket id that is every alert of the
// ticket (the claim link and the PostHog link
// both do, claimed or not). Thread replies, broadcast ones included, are not
// alerts. Read from the channel's recent history because PostHog's live runtime
// does not let a destination write the alert's ts back onto the ticket.
fun alertsMentioning(needle) {
  let history := fetch(f'https://slack.com/api/conversations.history?channel={inputs.channel}&limit=200', {
    'method': 'GET',
    'headers': {'Authorization': f'Bearer {inputs.slack_workspace.access_token}'}
  })
  if (history.status != 200 or history.body.ok == false) {
    throw Error(f'Slack history unreadable: {history.status}: {history.body}')
  }
  let found := []
  for (let message in (history.body.messages ?? [])) {
    let isReply := not empty(message.thread_ts) and message.thread_ts != message.ts
    if (not isReply and like(jsonStringify(message.blocks ?? []), f'%{needle}%')) {
      found := arrayPushBack(found, message.ts)
    }
  }
  return found
}

fun postToSlack(body) {
  let response := fetch('https://slack.com/api/chat.postMessage', {
    'method': 'POST',
    'headers': {
      'Authorization': f'Bearer {inputs.slack_workspace.access_token}',
      'Content-Type': 'application/json; charset=utf-8'
    },
    'body': body
  })
  if (response.status != 200 or response.body.ok == false) {
    throw Error(f'Slack refused the message: {response.status}: {response.body}')
  }
  return response.body
}

if (event.event == 'product_feedback_ticket_opened') {
  // Only an alert that links this deployment counts: the older workflow's
  // alert for the same ticket links production whatever the ticket's origin.
  if (not empty(alertsMentioning(claimUrl))) {
    print(f'Ticket {ticketId} has an alert for {host} already')
    return
  }
  let noContact := props.allow_contact == false ? f' · ⚠️ {copy.no_contact}' : ''
  let pageTeam := kind == 'bug' and isProd
  let blocks := []
  if (kind == 'bug') {
    blocks := arrayPushBack(blocks, {'type': 'header', 'text': {'type': 'plain_text', 'text': f'{title} #{number}'}})
    if (pageTeam) {
      blocks := arrayPushBack(blocks, {'type': 'section', 'text': {'type': 'mrkdwn', 'text': '<!here>'}})
    }
  } else {
    blocks := arrayPushBack(blocks, {'type': 'section', 'text': {'type': 'mrkdwn', 'text': f'*{title} #{number}*'}})
  }
  blocks := arrayPushBack(blocks, {'type': 'context', 'elements': [{'type': 'mrkdwn', 'text': f'{host}{noContact}'}]})
  let buttons := [
    {'type': 'button', 'style': 'primary', 'text': {'type': 'plain_text', 'text': f'🙋 {copy.claim}'}, 'url': claimUrl},
    {'type': 'button', 'text': {'type': 'plain_text', 'text': copy.open_ticket}, 'url': ticketUrl}
  ]
  if (not empty(person) and not empty(person.url)) {
    buttons := arrayPushBack(buttons, {'type': 'button', 'text': {'type': 'plain_text', 'text': 'Person & Replays'}, 'url': person.url})
  }
  blocks := arrayPushBack(blocks, {'type': 'actions', 'elements': buttons})
  let posted := postToSlack({
    'channel': inputs.channel,
    'username': 'Piloti Feedback',
    'text': pageTeam ? f'<!here> {title} #{number}{where}' : f'{title} #{number}{where}',
    'blocks': blocks
  })
  print(f'Posted alert {posted.ts} for ticket {ticketId} ({host})')
  return
}

if (event.event == 'product_feedback_reply_sent') {
  let message := {
    'channel': inputs.channel,
    'username': 'Piloti Feedback',
    'text': f'↩️ {copy.reporter_replied} #{number}{where}',
    'blocks': [
      {'type': 'section', 'text': {'type': 'mrkdwn', 'text': f'*↩️ {copy.reporter_replied} #{number}*{where}'}},
      {'type': 'actions', 'elements': [
        {'type': 'button', 'style': 'primary', 'text': {'type': 'plain_text', 'text': copy.reply_in_posthog}, 'url': ticketUrl}
      ]}
    ]
  }
  let alerts := alertsMentioning(ticketId)
  if (not empty(alerts)) {
    message.thread_ts := alerts[1]
    message.reply_broadcast := true
  }
  postToSlack(message)
  return
}

print(f'Event {event.event} is not one this destination posts')
