---
/**
 * A post's body from the CMS (ADR-0155): its blocks in order, each drawn by a component of
 * the design system. Markdown is rendered without raw HTML (src/lib/markdown.ts); a figure
 * is one of the drawings in ./figures, from the props the CMS holds; an image sits in the
 * figures' frame, from the CMS's transform presets; a quote and a call to action are the
 * site's own `Quote` and `CTABand`.
 */
import AITag from './AITag.astro';
import CTABand from './CTABand.astro';
import Quote from './Quote.astro';
import FigureFrame from './figures/FigureFrame.astro';
import HybridFigure from './figures/HybridFigure.astro';
import IsoStackFigure from './figures/IsoStackFigure.astro';
import LessonLoopFigure from './figures/LessonLoopFigure.astro';
import ScopeFigure from './figures/ScopeFigure.astro';
import type { Locale } from '../i18n/paths';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/ui';
import { assetUrl, cmsSettings } from '../lib/cms';
import { markdownToHtml } from '../lib/markdown';
import type { Block } from '../lib/post-model';

interface Props {
  locale: Locale;
  blocks: Block[];
}

const { locale, blocks } = Astro.props;
const ui = t(locale);
// A figure's props are JSON from the CMS; the component's own types cannot be known from it.
type FigureFromProps = (props: Record<string, unknown>) => unknown;
const FIGURES = { iso_stack: IsoStackFigure, scope: ScopeFigure, hybrid: HybridFigure, lesson_loop: LessonLoopFigure } as unknown as Record<string, FigureFromProps>;
// The pages a call to action may point at, with the label the navigation gives them.
const CTA_TARGETS: Record<string, { route: 'demo' | 'contact' | 'security'; label: string }> = {
  demo: { route: 'demo', label: ui.demo },
  contact: { route: 'contact', label: ui.kontakt },
  security: { route: 'security', label: ui.navSecurity },
};
const ctaLink = (key?: string) => {
  const target = key ? CTA_TARGETS[key] : undefined;
  return target ? { label: target.label, href: localePath(target.route, locale), key: target.route } : undefined;
};
const settings = cmsSettings();
const image = (file: string, preset: string) => (settings ? assetUrl(settings, file, preset) : '');
---

{
  blocks.map((block) => {
    if (block.kind === 'markdown') return <Fragment set:html={markdownToHtml(block.text)} />;
    if (block.kind === 'figure') {
      const Figure = FIGURES[block.component];
      return <Figure {...block.props} />;
    }
    if (block.kind === 'image') {
      return (
        <FigureFrame alt={block.alt} caption={block.caption}>
          <img
            src={image(block.file, 'inline')}
            srcset={`${image(block.file, 'inline-small')} 800w, ${image(block.file, 'inline')} 1600w`}
            sizes="(min-width: 1280px) 1200px, 100vw"
            alt={block.alt}
            loading="lazy"
            decoding="async"
          />
          {block.aiGenerated && <AITag locale={locale} />}
        </FigureFrame>
      );
    }
    if (block.kind === 'quote') return <Quote quote={block.quote} name={block.name} role={block.role} office={block.office} />;
    return <CTABand title={block.title} text={block.text} primary={ctaLink(block.primary)} secondary={ctaLink(block.secondary)} area="blog_post" />;
  })
}
