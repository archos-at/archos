---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PHOTO_QUALITY, PHOTO_WIDTHS, SIZES } from '../lib/media';

interface Props {
  quote: string;
  name: string;
  role?: string;
  office?: string;
  /** Portrait (4:5, from `src/lib/media.ts`) to the right, portrait-width wide */
  portrait?: ImageMetadata;
  portraitAlt?: string;
  class?: string;
}

const { quote, name, role, office, portrait, portraitAlt = '', class: className } = Astro.props;
const meta = [role, office].filter(Boolean).join(', ');
---

{
  portrait ? (
    <div data-reveal class:list={['ui-quote-wrap', className]}>
      <figure class="ui-quote">
        <blockquote>
          <p class="ui-quote-text heading-2">{quote}</p>
        </blockquote>
        <figcaption class="ui-quote-cite small">
          <span class="ui-quote-name">{name}</span>
          {meta && ` · ${meta}`}
        </figcaption>
      </figure>
      <div class="ui-quote-portrait">
        <Image src={portrait} widths={PHOTO_WIDTHS} sizes={SIZES.portrait} quality={PHOTO_QUALITY} alt={portraitAlt} />
      </div>
    </div>
  ) : (
    <div class={className}>
      <figure class="ui-quote">
        <blockquote>
          <p class="ui-quote-text heading-2">{quote}</p>
        </blockquote>
        <figcaption class="ui-quote-cite small">
          <span class="ui-quote-name">{name}</span>
          {meta && ` · ${meta}`}
        </figcaption>
      </figure>
    </div>
  )
}
