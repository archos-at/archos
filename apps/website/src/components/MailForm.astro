---
/**
 * A form that sends its content to the site's inbox (contact, demo).
 *
 * With JavaScript the script below posts the fields as JSON to `/api/enquiry`, which mails the
 * inbox and confirms to the visitor (README, "Forms"). When the site cannot send (no sender
 * configured, the send budget spent, the mail server down), it falls back to the visitor's mail
 * program: a `mailto:` with a subject and a readable `Label: value` body. Without JavaScript the
 * browser's own `mailto:` form post is that fallback. The fields are the default slot; every field
 * needs a `<label for>`, whose text (without the `*`) becomes its line in the mail.
 */
import Button from './Button.astro';
import type { Locale } from '../i18n/paths';

interface Props {
  /** The form's name in analytics (`form_submitted`, `form` property) */
  id: string;
  /** Recipient address */
  to: string;
  /** Subject; `{field}` tokens take a field's value by its `name` (empty ones are dropped) */
  subject: string;
  /** Shown after the hand-off to the mail program */
  sent: { title: string; text: string; fallback: string; edit: string };
  /** Shown after the site sent the enquiry itself */
  delivered: { title: string; text: string };
  /** How the form's checkbox reads in the mail: a short label, and its ticked and unticked value */
  checkbox?: { label: string; yes: string; no: string };
  /** The language of the visitor's confirmation mail */
  locale: Locale;
  class?: string;
}

const { id, to, subject, sent, delivered, checkbox, locale, class: className } = Astro.props;
---

<div class:list={['mail-form', className]} data-mail-form={id}>
  <form
    action={`mailto:${to}`}
    method="post"
    enctype="text/plain"
    class="ui-form-grid"
    data-ph-capture-attribute-form={id}
    data-to={to}
    data-subject={subject}
    data-checkbox-label={checkbox?.label}
    data-yes={checkbox?.yes}
    data-no={checkbox?.no}
    data-locale={locale}
  >
    <slot />
    <div class="ui-visually-hidden" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
  <div class="mail-form-sent" data-via="server" role="status" tabindex="-1" hidden>
    <h2 class="heading-3">{delivered.title}</h2>
    <p class="body">{delivered.text}</p>
  </div>
  <div class="mail-form-sent" data-via="mailto" role="status" tabindex="-1" hidden>
    <h2 class="heading-3">{sent.title}</h2>
    <p class="body">{sent.text}</p>
    <p class="small">
      {sent.fallback} <a class="ui-link" href={`mailto:${to}`}>{to}</a>.
    </p>
    <Button variant="secondary" size="md" class="mail-form-edit">{sent.edit}</Button>
  </div>
</div>

<script>
  import { fillSubject, mailBody, mailtoHref, type MailLine } from '../lib/mailto';

  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type Analytics = { capture: (event: string, properties: Record<string, unknown>) => void };

  /** A field's label text without the required marker. */
  function labelOf(form: HTMLFormElement, field: Field): string {
    const label = field.id ? form.querySelector(`label[for="${field.id}"]`) : field.closest('label');
    return (label?.textContent ?? field.name).replace(/\s*\*\s*$/, '').trim();
  }

  /** Posts the enquiry; true when the site sent it, false when the mail program has to. */
  async function sendFromSite(body: Record<string, unknown>): Promise<boolean> {
    try {
      const response = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      return response.ok && ((await response.json()) as { sent?: boolean }).sent === true;
    } catch {
      return false;
    }
  }

  function setup(root: HTMLElement) {
    const form = root.querySelector('form');
    const delivered = root.querySelector<HTMLElement>('.mail-form-sent[data-via="server"]');
    const handedOff = root.querySelector<HTMLElement>('.mail-form-sent[data-via="mailto"]');
    const submit = root.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!form || !delivered || !handedOff) return;
    const { to = '', subject = '', checkboxLabel = '', yes = '', no = '', locale = 'de' } = form.dataset;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const fields = [...form.elements].filter(
        (el): el is Field => (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) && el.name !== '' && el.name !== 'website',
      );
      const values: Record<string, string> = {};
      const lines: MailLine[] = [];
      let message = '';
      let newsletter: boolean | undefined;
      for (const field of fields) {
        if (field instanceof HTMLInputElement && field.type === 'checkbox') {
          newsletter = field.checked;
          lines.push({ label: checkboxLabel || labelOf(form, field), value: field.checked ? yes : no });
          continue;
        }
        values[field.name] = field.value;
        if (field instanceof HTMLTextAreaElement) message = field.value;
        else lines.push({ label: labelOf(form, field), value: field.value });
      }
      const filledSubject = fillSubject(subject, values);
      const name = values.name ?? [values['first-name'], values['last-name']].filter(Boolean).join(' ');

      if (submit) submit.disabled = true;
      const sentBySite = await sendFromSite({
        form: root.dataset.mailForm,
        locale,
        subject: filledSubject,
        email: values.email ?? '',
        name,
        lines: lines.filter((line) => line.value.trim() !== ''),
        message,
        website: (form.elements.namedItem('website') as HTMLInputElement | null)?.value ?? '',
      });
      if (submit) submit.disabled = false;
      if (!sentBySite) location.href = mailtoHref(to, filledSubject, mailBody(lines, message));

      // The one event autocapture cannot see: the hand-off itself. No field values.
      const analytics = (window as { posthog?: Analytics }).posthog;
      analytics?.capture('form_submitted', {
        form: root.dataset.mailForm,
        method: sentBySite ? 'site' : 'mailto',
        locale: document.documentElement.lang,
        ...(newsletter === undefined ? {} : { newsletter }),
      });

      const shown = sentBySite ? delivered : handedOff;
      form.hidden = true;
      shown.hidden = false;
      shown.focus();
    });

    handedOff.querySelector('.mail-form-edit')?.addEventListener('click', () => {
      handedOff.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>('input, select, textarea')?.focus();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-mail-form]').forEach(setup);
</script>
