---
import PostCover from './PostCover.astro';
import type { Locale } from '../i18n/paths';
import type { Cover } from '../lib/post-model';

interface Props {
  title: string;
  text?: string;
  date?: string;
  /** The post's category, printed before the date */
  label?: string;
  href?: string;
  /** A blog post's cover, a line drawing or a CMS image (wins over `image`) */
  cover?: Cover;
  /** Needed with `cover`, for an image cover's AI mark */
  locale?: Locale;
  /** Image 3:2 */
  image?: string;
  imageAlt?: string;
  class?: string;
}

const { title, text, date, label, href, cover, locale = 'de', image, imageAlt = '', class: className } = Astro.props;
// A card without a real URL is a plain block, not a link.
const Tag = href ? 'a' : 'div';
---

<li class:list={['ui-post', className]}>
  <Tag href={href}>
    <div class="ui-post-media">
      {cover ? <PostCover cover={cover} variant="card" locale={locale} /> : image && <img src={image} alt={imageAlt} loading="lazy" decoding="async" />}
    </div>
    <h3 class="ui-post-title heading-3">{title}</h3>
    {text && <p class="ui-post-text body">{text}</p>}
    {
      (label || date) && (
        <p class="ui-post-date small">
          {label && <span>{label}</span>}
          {label && date && <span aria-hidden="true"> · </span>}
          {date}
        </p>
      )
    }
  </Tag>
</li>
