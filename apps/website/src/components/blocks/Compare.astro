---
/**
 * Two states of the same drawing, one over the other, with a divider the reader moves. Without
 * script both stand one above the other, each with its name; the script lays them on top of
 * each other and hands the divider to a native range input, so arrow keys, Home/End, a
 * screen reader's slider and a pointer or a finger all move the same value.
 * Contract: contracts.ts (`CompareBlock`). Rules: packages/brand/docs/components/Compare.md.
 */
import '../../styles/brand/blocks.css';
import type { Locale } from '../../i18n/paths';
import { format, t } from '../../i18n/ui';
import type { CompareBlock } from './contracts';

interface Props extends CompareBlock {
  locale: Locale;
  class?: string;
}

const { locale, before, after, beforeLabel, afterLabel, caption, start = 50, class: className } = Astro.props;
const ui = t(locale);
const position = Math.round(start);
const panes = [
  { side: 'before', image: before, label: beforeLabel },
  { side: 'after', image: after, label: afterLabel },
];
---

<figure
  class:list={['ui-block ui-block-wide ui-compare', className]}
  data-compare
  data-value-text={format(ui.blockCompareValue, { before: beforeLabel, after: afterLabel, position: '{position}' })}
>
  <div class="ui-compare-stage">
    {
      panes.map((pane) => (
        <div class="ui-compare-pane" data-side={pane.side}>
          <span class="ui-compare-label">{pane.label}</span>
          <img
            src={pane.image.src}
            srcset={pane.image.srcset}
            sizes={pane.image.sizes ?? '(min-width: 1280px) 1040px, (min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)'}
            width={pane.image.width}
            height={pane.image.height}
            alt={pane.image.alt}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </div>
      ))
    }
    <input
      class="ui-compare-range"
      type="range"
      min="0"
      max="100"
      step="1"
      value={position}
      aria-label={format(ui.blockCompareSlider, { before: beforeLabel, after: afterLabel })}
      aria-valuetext={format(ui.blockCompareValue, { before: beforeLabel, after: afterLabel, position })}
      hidden
    />
    <span class="ui-compare-handle" aria-hidden="true">
      <span class="ui-compare-knob">
        <svg viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
          <path d="M6 1L1 6l5 5M14 1l5 5-5 5" />
        </svg>
      </span>
    </span>
  </div>
  {caption && <figcaption class="ui-block-caption">{caption}</figcaption>}
</figure>

<script>
  // Each compare block on the page: overlay the two states and let the range move the divider.
  // State lives in the input's value; the panes and the handle only follow it.
  for (const root of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const stage = root.querySelector<HTMLElement>('.ui-compare-stage');
    const range = root.querySelector<HTMLInputElement>('.ui-compare-range');
    const after = root.querySelector<HTMLElement>('.ui-compare-pane[data-side="after"]');
    const handle = root.querySelector<HTMLElement>('.ui-compare-handle');
    if (!stage || !range || !after || !handle) continue;
    const valueText = root.dataset.valueText ?? '';

    const show = () => {
      const position = Number(range.value);
      after.style.clipPath = `inset(0 0 0 ${position}%)`;
      handle.style.left = `${position}%`;
      range.setAttribute('aria-valuetext', valueText.replace('{position}', String(position)));
    };
    // A press anywhere on the drawing moves the divider there, and a drag carries it along:
    // a phone's range input moves only by its thumb, so the pointer is followed here.
    const follow = (event: PointerEvent) => {
      const box = stage.getBoundingClientRect();
      range.value = String(Math.round(((event.clientX - box.left) / box.width) * 100));
      show();
    };
    range.addEventListener('pointerdown', (event) => {
      range.setPointerCapture(event.pointerId);
      follow(event);
    });
    range.addEventListener('pointermove', (event) => {
      if (range.hasPointerCapture(event.pointerId)) follow(event);
    });
    range.addEventListener('input', show);

    range.hidden = false;
    root.dataset.ready = '';
    show();
  }
</script>
