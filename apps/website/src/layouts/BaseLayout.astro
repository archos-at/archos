---
import '../styles/brand/tokens.css';
import '../styles/brand/components.css';
import '../styles/brand/motion.css';
import '../styles/site.css';
import ConsentNote from '../components/ConsentNote.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { alternateOf, isUnlisted, type Locale } from '../i18n/paths';
import { t } from '../i18n/ui';
import identity from '../lib/identity';
import { breadcrumbList, faqPage, jsonLd, siteGraph, type Crumb, type GraphNode } from '../lib/structured-data';
import { surfaceColor } from '../lib/theme';
import signedInScript from '../scripts/signed-in.js?url&no-inline';

interface Props {
  /** The page's language: sets `<html lang>`, the shell's strings and the hreflang pair */
  locale: Locale;
  /** Page name, printed as `<title> – <brand>`. On the home page the brand comes first (`brandFirst`). */
  title: string;
  /** The home page: `<brand> – <title>` */
  brandFirst?: boolean;
  description: string;
  /** Keeps the page out of search results (an unlisted page in paths.ts always is) */
  noindex?: boolean;
  /** Renders without header and footer (the split pages: Demo) */
  bare?: boolean;
  /** The other locale's twin of this page, when its path is not the table's (a post's translation) */
  alternatePath?: string;
  /**
   * JSON-LD breadcrumbs between home and this page (home and the page itself are added).
   * Every indexed page except home gets Start › <title> by default.
   */
  crumbs?: Crumb[];
  /** The FAQ items the page renders: emitted as an `FAQPage` too */
  faq?: { q: string; a: string }[];
  /** More JSON-LD nodes for this page (`SoftwareApplication` on home, `BlogPosting` on a post) */
  graph?: GraphNode[];
  /** The page links its blog feed (`<link rel="alternate" type="application/rss+xml">`) */
  feed?: string;
  /** The page's own share image (1200 × 630) and its alt text; every other page shares the share card */
  image?: { path: string; alt: string };
}

const {
  locale,
  title,
  brandFirst = false,
  description,
  noindex: noindexProp = false,
  bare = false,
  alternatePath,
  crumbs = [],
  faq,
  graph = [],
  feed,
  image,
} = Astro.props;
const ui = t(locale);
const noindex = noindexProp || isUnlisted(Astro.url.pathname);
const pageTitle = brandFirst ? `${identity.name} – ${title}` : `${title} – ${identity.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang: the page and its other-locale twin, German as x-default.
const here = Astro.url.pathname;
const there = alternatePath ?? alternateOf(here);
const hrefFor = (target: Locale) => new URL(target === locale ? here : there, Astro.site);
// Social previews: the share card is the one image every page shares; og:locale names the region.
const ogLocale: Record<Locale, string> = { de: 'de_AT', en: 'en_GB' };
const shareImage = new URL(image?.path ?? '/media/share-card.png', Astro.site);
const site = Astro.site ?? new URL(`https://${identity.domain}`);
const isHome = here === '/' || here === '/en/' || here === '/en';
const nodes: GraphNode[] = [...graph];
if (!noindex && !isHome) {
  const home = { name: ui.breadcrumbHome, path: locale === 'en' ? '/en/' : '/' };
  nodes.push(breadcrumbList(site, [home, ...crumbs, { name: title, path: here }]));
}
if (faq?.length) nodes.push(faqPage(site, here, faq));
const structuredData = jsonLd(siteGraph(site, locale, nodes));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image?.alt ?? identity.claim} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[locale === 'de' ? 'en' : 'de']} />
    <meta property="og:site_name" content={identity.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="de" href={hrefFor('de')} />
          <link rel="alternate" hreflang="en" href={hrefFor('en')} />
          <link rel="alternate" hreflang="x-default" href={hrefFor('de')} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {feed && <link rel="alternate" type="application/rss+xml" title={ui.rssTitle} href={feed} />}
    <meta name="theme-color" content={surfaceColor} />
    <script type="application/ld+json" set:html={structuredData} />
    <!-- Blocking on purpose and tiny: swaps Login for "App öffnen" before the header paints (README, "Signed in"). -->
    <script is:inline src={signedInScript}></script>
    <!-- Web analytics, configured per stack at request time; a comment when
         PostHog is unset (src/pages/web-analytics.js.ts, runtime/web-analytics.mjs). -->
    <script is:inline src="/web-analytics.js" defer></script>
  </head>
  <body>
    <a class="site-skip" href="#main">{ui.skipLink}</a>
    {!bare && <Header locale={locale} current={Astro.url.pathname} switchPath={alternatePath} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
    <ConsentNote locale={locale} />
    <script>
      // Blocks below the fold arrive once as they scroll into view (styles in
      // packages/brand/css/motion.css). Anything on screen at load is left alone,
      // and reduced motion or print leaves the page as it is.
      //
      // The blocks that come into view together are one batch: each gets its index in
      // reading order (`--ui-reveal-index`), so a row of tiles arrives left to right and a
      // tile that arrives alone does not wait. A block reached from above, or already in
      // view when the observer first reports (a restored scroll, an anchor), is shown at once.
      const motion = matchMedia('screen and (prefers-reduced-motion: no-preference)');
      if (motion.matches && 'IntersectionObserver' in window) {
        const inReadingOrder = (a: IntersectionObserverEntry, b: IntersectionObserverEntry) =>
          a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
        const showAtOnce = (block: HTMLElement) => {
          block.classList.add('is-instant');
          block.classList.remove('is-pending');
          // Kept for a frame, so the style change lands without a transition.
          requestAnimationFrame(() => requestAnimationFrame(() => block.classList.remove('is-instant')));
        };
        let first = true;
        const arrive = new IntersectionObserver((entries) => {
          const arriving = entries.filter((entry) => entry.isIntersecting).sort(inReadingOrder);
          // The stagger counts among siblings (the tiles of one grid, the steps of one
          // timeline); unrelated blocks arriving together start together.
          const counts = new Map<Node | null, number>();
          for (const entry of arriving) {
            const block = entry.target as HTMLElement;
            arrive.unobserve(block);
            if (first || entry.boundingClientRect.top < 0) {
              showAtOnce(block);
              continue;
            }
            const index = counts.get(block.parentNode) ?? 0;
            counts.set(block.parentNode, index + 1);
            block.style.setProperty('--ui-reveal-index', String(index));
            block.classList.remove('is-pending');
          }
          first = false;
        }, { rootMargin: '0px 0px -8% 0px' });
        for (const block of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
          if (block.getBoundingClientRect().top < innerHeight) continue;
          block.classList.add('is-pending');
          arrive.observe(block);
        }
      }
    </script>
  </body>
</html>
