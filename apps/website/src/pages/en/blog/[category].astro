---
import BlogView from '../../../views/BlogView.astro';
import { CATEGORY_IDS, CATEGORIES } from '../../../lib/categories';
import { getBlogPosts } from '../../../lib/posts';

// /en/blog/<segment>/. See the German route for why it shares a level with [slug].astro.
export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({ params: { category: CATEGORIES.en[category].segment }, props: { category } }));
}

const { category } = Astro.props;
const posts = await getBlogPosts('en', category);
---

<BlogView locale="en" posts={posts} category={category} />
