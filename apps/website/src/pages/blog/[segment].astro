---
import BlogPostView from '../../views/BlogPostView.astro';
import BlogView from '../../views/BlogView.astro';
import { categoryOfSegment } from '../../lib/categories';
import { BLOG_CACHE_CONTROL, findPost, getBlogPosts } from '../../lib/posts';

// Rendered on request (ADR-0155), from the CMS or the fixtures: a category listing when the
// segment is one of the locale's category segments (src/lib/categories.ts), else the post with
// that slug, else a 301 from a slug the post had before, else the 404 page. Categories and
// posts share this URL level, and two dynamic routes at one level cannot both render on request.
export const prerender = false;
const segment = Astro.params.segment ?? '';
const category = categoryOfSegment('de', segment);
const found = category ? undefined : await findPost('de', segment);
if (!category && !found) return Astro.rewrite('/404/');
if (found && 'redirect' in found) return Astro.redirect(found.redirect, 301);
const post = found && 'post' in found ? found.post : undefined;
const posts = category ? await getBlogPosts('de', category) : [];
Astro.response.headers.set('Cache-Control', BLOG_CACHE_CONTROL);
---

{category ? <BlogView locale="de" posts={posts} category={category} /> : post && <BlogPostView locale="de" post={post} />}
