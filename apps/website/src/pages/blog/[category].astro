---
import BlogView from '../../views/BlogView.astro';
import { CATEGORY_IDS, CATEGORIES } from '../../lib/categories';
import { getBlogPosts } from '../../lib/posts';

// /blog/<segment>/, the segment being the category's German label (src/lib/categories.ts).
// Shares its URL level with [slug].astro; getStaticPaths there refuses a post slug that
// equals a category segment, so the two never collide.
export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({ params: { category: CATEGORIES.de[category].segment }, props: { category } }));
}

const { category } = Astro.props;
const posts = await getBlogPosts('de', category);
---

<BlogView locale="de" posts={posts} category={category} />
