---
import BlogView from '../../views/BlogView.astro';
import { BLOG_CACHE_CONTROL, getBlogPosts } from '../../lib/posts';

// Rendered on request (ADR-0155), from the CMS or the fixtures.
export const prerender = false;
const posts = await getBlogPosts('de');
Astro.response.headers.set('Cache-Control', BLOG_CACHE_CONTROL);
---

<BlogView locale="de" posts={posts} />
