---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextLink from '../components/TextLink.astro';
import copy from '../i18n/pages/changelog';
import type { Locale } from '../i18n/paths';
import { withName } from '../lib/identity';
import { feedPath, getReleases, releaseAnchor, releaseTitle } from '../lib/changelog';

// Markup and structure only. The frame's text comes from src/i18n/pages/changelog.ts; the weekly
// summaries are product data from src/data/changelog.json, written by scripts/release_notes.py (never
// by hand). The public page is the summaries alone (ADR-0156): each week is one row of the design
// system's two-column layout (ui-rows: its dates as the heading left, its summary right), with a
// stable anchor per week. The single notes are for signed-in customers, in the app.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = withName(copy[locale]);
const releases = getReleases();
---

<BaseLayout locale={locale} title={c.meta.title} description={c.meta.description}>
  <Hero title={c.hero.title} text={c.hero.text} />
  <section class="ui-container ui-section page-main">
    <p class="body">{c.inApp}</p>
    <p class="small">
      {c.formerName} <TextLink href={feedPath(locale)}>{c.feed.link}</TextLink>
    </p>
    {releases.length === 0 && <p class="body">{c.empty}</p>}
    {
      releases.map((release) => (
        <article id={releaseAnchor(release)} class="ui-rows">
          <h2 class="heading-2">
            {release.date ? (
              <time datetime={release.date}>{releaseTitle(release, locale, c.unreleased)}</time>
            ) : (
              releaseTitle(release, locale, c.unreleased)
            )}
          </h2>
          <div class="ui-faq body">
            <p>{release.summary[locale]}</p>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
