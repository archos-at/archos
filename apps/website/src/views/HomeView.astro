---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DuoCards, { type DuoItem } from '../components/DuoCards.astro';
import FeatureTiles from '../components/FeatureTiles.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import LogoRow from '../components/LogoRow.astro';
import Quote from '../components/Quote.astro';
import SectionIntro from '../components/SectionIntro.astro';
import TeamRow from '../components/TeamRow.astro';
import Timeline from '../components/Timeline.astro';
import Video from '../components/Video.astro';
import { navigation } from '../i18n/nav';
import copy from '../i18n/pages/home';
import { localePath, type Locale } from '../i18n/paths';
import identity from '../lib/identity';
import { softwareApplication } from '../lib/structured-data';
import { withName } from '../lib/identity';
import { PILOT_OFFICES } from '../lib/pilot-offices';
import { founderPortraits, knowledgeVideo, photos, productImages, SCREENSHOT_QUALITY, SCREENSHOT_WIDTHS, SIZES } from '../lib/media';

// Markup and structure only. Text comes from src/i18n/pages/home.ts, in both locales.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = withName(copy[locale]);
const nav = navigation(locale);
const site = Astro.site ?? new URL(`https://${identity.domain}`);
const product = softwareApplication(site, locale, c.meta.description, localePath('home', locale));

const galleryImages = [productImages.searchDerivation, productImages.compareClearance, productImages.modelCheck];
// The knowledge animation has German text baked into its frames and there is no English cut yet,
// so only the German page plays it. Every product screenshot already appears on this page, and a
// repeat reads as a fault, so the English section goes on to its next block without a visual.
const showKnowledgeVideo = locale === 'de';
// The photos show in their own colours and brightness: no filter. The text on them reaches its
// contrast through the scrim behind the text (components.css, "Duo photo scrim").
const duo: [DuoItem, DuoItem] = [
  {
    ...c.statement.duo[0],
    photo: photos.plannerDesign,
    photoStyle: 'object-position: 60% 100%;',
    onPhoto: true,
    ai: true,
  },
  {
    ...c.statement.duo[1],
    photo: photos.aiSearchCompare,
    photoStyle: 'object-position: 50% 70%;',
    ai: true,
  },
];
const galleryItems = c.gallery.items.map((item, i) => ({ ...item, image: galleryImages[i] }));
const founders = c.founders.people.map((person, i) => ({ ...person, portrait: founderPortraits[i] }));
---

<BaseLayout locale={locale} title={c.meta.title} brandFirst description={c.meta.description} graph={[product]}>
  <Hero title={c.hero.title} text={c.hero.text}>
    <Image
      slot="media"
      src={productImages.planRevisionChanges}
      widths={SCREENSHOT_WIDTHS}
      sizes={SIZES.hero}
      quality={SCREENSHOT_QUALITY}
      loading="eager"
      fetchpriority="high"
      alt={c.hero.alt}
    />
  </Hero>

  <section class="ui-container ui-section">
    <SectionIntro layout="split" title={c.workload.title} lead={c.workload.lead} text={c.workload.text} />
  </section>

  <Gallery locale={locale} items={galleryItems} label={c.gallery.label} id="funktionen" />

  <section class="ui-container ui-section">
    <SectionIntro size="display" align="center" title={c.knowledge.title} text={c.knowledge.text} />
    {
      showKnowledgeVideo && (
        <div style="margin-top: var(--space-16);">
          <Video locale={locale} name="knowledge" sources={knowledgeVideo.sources} poster={knowledgeVideo.poster.src} label={c.knowledge.videoLabel} />
        </div>
      )
    }
    <div style="margin-top: var(--space-16);">
      <SectionIntro
        layout="split"
        size="subheading"
        as="h3"
        title={c.knowledge.intelligence.title}
        text={c.knowledge.intelligence.text}
      />
    </div>
  </section>

  <section class="ui-band">
    <div class="ui-container ui-section">
      <SectionIntro size="display" align="center" title={c.statement.title} class="ui-duo-intro" />
      <div style="margin-top: var(--space-16);">
        <DuoCards locale={locale} items={duo} />
      </div>
    </div>
  </section>

  <section class="ui-container ui-section">
    <SectionIntro title={c.built.title} />
    <Image
      class="home-built-image"
      data-reveal="unveil"
      src={productImages.floorPlanQuery}
      widths={SCREENSHOT_WIDTHS}
      sizes={`(max-width: 767px) calc((100vw - 32px) * 2.25), ${SIZES.container}`}
      quality={SCREENSHOT_QUALITY}
      alt={c.built.imageAlt}
      style="display: block; width: 100%; height: auto; aspect-ratio: 4864 / 1620; object-fit: cover; object-position: left center; margin: var(--space-8) 0 var(--space-16); background: var(--surface-sunken);"
    />
    <FeatureTiles items={c.built.features} columns={3} />
  </section>

  <section class="ui-band">
    <div class="ui-container ui-section">
      <SectionIntro title={c.roadmap.title} />
      <div style="margin-top: var(--space-16);">
        <Timeline steps={c.roadmap.steps} current={0} />
      </div>
    </div>
  </section>

  <section class="ui-container ui-section">
    <Quote
      class="home-quote"
      quote={c.quote.text}
      name={c.quote.name}
      role={c.quote.role}
      office="feld72"
      portrait={photos.teamConversation}
      portraitAlt={c.quote.portraitAlt}
    />
    <div style="margin-top: calc(var(--space-24) + var(--space-4));">
      <LogoRow logos={PILOT_OFFICES} />
    </div>
  </section>

  <section class="ui-container ui-section">
    <div class="site-split">
      <div>
        <SectionIntro size="heading" title={c.founders.title} />
        <div style="margin-top: var(--space-8);">
          <TeamRow members={founders} />
        </div>
        <p class="small" style="margin: var(--space-4) 0 0; color: var(--ink-muted);">{c.founders.caption}</p>
      </div>
      <div class="home-founders-action">
        <p class="lead" style="margin: 0;">{c.founders.lead}</p>
        <Button href={nav.demo.href} variant="secondary" size="lg" cta="founders" ctaLabel="demo">{nav.demo.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
