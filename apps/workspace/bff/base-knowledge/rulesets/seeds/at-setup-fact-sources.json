        {
          "id": "plot",
          "determinant": "plot",
          "label": "Grundstück, Fläche und Einlagezahl",
          "factKeys": [
            "plot_register_number",
            "plot_area"
          ],
          "appliesWhen": {},
          "request": {
            "document": "Grundbuchauszug",
            "reason": "Der Grundbuchauszug nennt Einlagezahl und Katastralgemeinde, die Grundstücke mit ihrer Fläche, die Eigentümer und Lasten wie Dienstbarkeiten."
          },
          "sources": [
            {
              "title": "Allgemeines Grundbuchsgesetz 1955 (GBG 1955)",
              "needsReview": true
            }
          ]
        },
        {
          "id": "zoning",
          "determinant": "zoning",
          "label": "Widmung und Bebauungsbestimmungen",
          "factKeys": [
            "zoning",
            "development_plan"
          ],
          "appliesWhen": {
            "projectTypes": [
              "new_build",
              "extension",
              "conversion",
              "change_of_use"
            ]
          },
          "request": {
            "document": "Auszug aus Flächenwidmungs- und Bebauungsplan",
            "reason": "Die Gemeinde legt im Flächenwidmungsplan fest, wofür das Grundstück genutzt werden darf, und im Bebauungsplan, wie hoch, wie dicht und wo gebaut werden darf. Nicht für jedes Grundstück gibt es einen Bebauungsplan."
          },
          "sources": [
            {
              "title": "Raumordnungsgesetz des Bundeslandes",
              "needsReview": true
            }
          ],
          "variants": {
            "AT-9": {
              "document": "Plandokument (Flächenwidmungs- und Bebauungsplan)",
              "reason": "In Wien legt ein Plandokument Widmung und Bebauungsbestimmungen gemeinsam fest: Widmung, Bauklasse, Bauweise, Fluchtlinien und Schutzzonen.",
              "sources": [
                {
                  "title": "Bauordnung für Wien (BO für Wien)",
                  "reference": "§§ 1–5 (Flächenwidmungs- und Bebauungspläne), § 7 (Schutzzonen)",
                  "needsReview": true
                }
              ]
            },
