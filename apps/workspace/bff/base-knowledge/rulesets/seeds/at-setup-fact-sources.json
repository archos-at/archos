                  "needsReview": true
                }
              ]
            }
          },
          "additions": [
            {
              "territoryId": "AT-6",
              "municipality": "Graz",
              "addition": "In der Grazer Altstadt kann zusätzlich eine Schutzzone nach dem Grazer Altstadterhaltungsgesetz gelten.",
