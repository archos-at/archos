          ]
        },
        {
          "id": "heritage",
          "determinant": "heritage",
          "label": "Denkmal- und Ortsbildschutz",
          "factKeys": [
            "heritage_protection"
          ],
          "appliesWhen": {
            "existing": true
          },
          "request": {
            "document": "Auszug aus der Denkmalliste oder Unterschutzstellungsbescheid",
            "reason": "Ein Gebäude unter Denkmalschutz darf nur mit Bewilligung des Bundesdenkmalamts verändert werden. Ob es geschützt ist, steht in der Denkmalliste des Bundesdenkmalamts oder in einem Bescheid."
          },
          "sources": [
            {
              "title": "Denkmalschutzgesetz (DMSG)",
              "needsReview": false
            }
          ]
        },
        {
          "id": "hazards",
          "determinant": "hazards",
          "label": "Naturgefahren und Altlasten",
          "factKeys": [
            "hazard_zones"
          ],
          "appliesWhen": {
            "projectTypes": [
              "new_build",
              "extension",
              "demolition"
            ]
          },
          "request": {
            "document": "Auszug aus dem Gefahrenzonenplan, Auskunft aus dem Verdachtsflächenkataster",
            "reason": "Gefahrenzonen der Wildbach- und Lawinenverbauung und Hochwasserabflussbereiche können Bauverbote oder Auflagen bedeuten; meist sind sie im Flächenwidmungsplan ersichtlich gemacht. Eine Altlast oder Verdachtsfläche betrifft Aushub, Abbruch und Gründung."
          },
          "sources": [
            {
              "title": "Forstgesetz 1975",
              "reference": "§ 11 (Gefahrenzonenpläne)",
              "needsReview": true
            },
            {
              "title": "Wasserrechtsgesetz 1959 (WRG 1959)",
              "reference": "§ 42a (Gefahrenzonenplanungen)",
              "needsReview": true
            },
            {
              "title": "Altlastensanierungsgesetz (ALSAG)",
              "reference": "Verdachtsflächenkataster und Altlastenatlas des Umweltbundesamts",
              "needsReview": true
            }
          ]
        },
        {
          "id": "noise",
          "determinant": "noise",
          "label": "Lärm",
          "factKeys": [
            "noise_situation"
          ],
          "appliesWhen": {
            "projectTypes": [
              "new_build",
              "extension",
              "conversion",
              "refurbishment",
              "change_of_use"
            ],
            "uses": [
              "residential",
              "lodging",
              "education",
              "healthcare",
              "office"
            ]
          },
          "request": {
            "document": "Lärmgutachten oder Auszug aus der Lärmkarte",
            "reason": "Der Außenlärm am Standort bestimmt, wie gut Fenster und Außenbauteile dämmen müssen. Die strategischen Lärmkarten für Straße, Bahn, Flugverkehr und Industrie zeigt lärminfo.at."
          },
          "sources": [
            {
              "title": "OIB-Richtlinie 5, Schallschutz (Ausgabe 2023)",
              "reference": "Anforderungen an Außenbauteile nach dem maßgeblichen Außenlärmpegel",
              "needsReview": true
            },
            {
              "title": "Bundes-Umgebungslärmschutzgesetz (Bundes-LärmG)",
              "reference": "strategische Lärmkarten",
              "needsReview": true
            }
          ]
        },
        {
          "id": "section",
          "label": "Geschoße und Fluchtniveau",
          "factKeys": [
            "escape_level_m",
            "storeys_above_ground"
          ],
          "request": {
            "document": "Schnitt aus dem Einreichplan",
            "reason": "Der Schnitt zeigt die Geschoße über dem Gelände und die Höhen, aus denen das Fluchtniveau folgt: die Fußbodenoberkante des höchstgelegenen oberirdischen Geschoßes über der angrenzenden Geländeoberfläche nach Fertigstellung. Beide bestimmen die Gebäudeklasse."
          },
          "sources": [
            {
              "title": "OIB-Richtlinien, Begriffsbestimmungen (Ausgabe Mai 2023)",
              "reference": "Fluchtniveau; Gebäudeklassen",
              "needsReview": true
            }
          ]
        }
      ]
    }
