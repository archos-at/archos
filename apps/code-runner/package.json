{
  "name": "code-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs one agent-written JavaScript module in a fresh workerd isolate with no network, and returns its result and the files it wrote.",
  "scripts": {
    "build": "node build/build.mjs",
    "start": "node bin/server.mjs",
    "test": "node build/build.mjs && node --test --test-concurrency=1 'test/*.test.mjs'"
  },
  "dependencies": {
    "workerd": "1.20261112.1"
  },
  "devDependencies": {
    "@cloudflare/computer": "0.11.2",
    "@cloudflare/puppeteer": "2.0.1",
    "@formepdf/core": "0.31.0",
    "@formepdf/react": "0.31.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "docx": "9.15.3",
    "esbuild": "0.25.10",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "marked": "18.1.3",
    "mathjs": "15.2.0",
    "papaparse": "5.7.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.0",
    "source-code-pro": "2.42.0",
    "source-sans": "3.52.0",
    "sucrase": "3.35.1",
    "unpdf": "2.1.0",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0"
  }
}
