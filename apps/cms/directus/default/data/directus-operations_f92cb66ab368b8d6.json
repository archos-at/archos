      "key": "drafts",
      "name": "Drafts it lacks",
      "options": {
        "code": "module.exports = async function (data) {\n  const post = Array.isArray(data.post) ? data.post[0] : data.post;\n  const account = 'linkedin-company';\n  const have = new Set((post.social_posts || []).filter((s) => s.account === account).map((s) => s.language));\n  const drafts = (post.translations || [])\n    .filter((t) => !have.has(t.languages_code))\n    .map((t) => ({ status: 'draft', account, language: t.languages_code, blog_post: post.id, text: t.description }));\n  return { drafts, count: drafts.length };\n};"
      },
